# name: test_snapshot_positions_nested_group_block
  '''
  from bpy.types import GeometryNodeTree
  from nodebpy import geometry as g, TreeBuilder
  from nodebpy.builder import CustomGeometryGroup
  
  
  class SnapInner(CustomGeometryGroup):
      _name = "SnapInner"
  
      def _build_group(self, tree: TreeBuilder[GeometryNodeTree]) -> None:
          tree.disable_arrange()
  
          geometry = tree.inputs.geometry("Geometry")
          geometry_1 = tree.outputs.geometry("Geometry")
  
          geometry >> g.SetPosition() >> geometry_1
  
          # Restore authored node names and positions (matched by tree
          # structure — see TreeBuilder.layout_snapshot).
          tree.layout_snapshot = {
              "Group Input": ("NodeGroupInput", (0.0, 0.0), None, ()),
              "Group Output": ("NodeGroupOutput", (400.0, 120.0), None, (("Geometry", "Set Position", "Geometry"), )),
              "Set Position": ("GeometryNodeSetPosition", (200.0, 60.0), None, (("Geometry", "Group Input", "Geometry"), )),
          }
  
  
  with TreeBuilder("SnapNested", arrange=None) as tree:
      geometry = tree.inputs.geometry("Geometry")
      geometry_1 = tree.outputs.geometry("Geometry")
  
      SnapInner(Geometry=geometry) >> geometry_1
  
  # Restore authored node names and positions (matched by tree
  # structure — see TreeBuilder.layout_snapshot).
  tree.layout_snapshot = {
      "Group Input": ("NodeGroupInput", (0.0, 0.0), None, ()),
      "Group Output": ("NodeGroupOutput", (240.0, 100.0), None, (("Geometry", "SnapInner", "Geometry"), )),
      "SnapInner": ("GeometryNodeGroup", (120.0, 50.0), None, (("Geometry", "Group Input", "Geometry"), )),
  }
  '''
