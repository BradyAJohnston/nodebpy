# serializer version: 1
# name: test_codegen_list_methods
  '''
  from nodebpy import TreeBuilder
  from nodebpy import geometry as g
  
  with TreeBuilder("Geometry Node Group") as tree:
      filtered = tree.outputs.vector("Filtered")
  
      (
          g.FieldToList(count=10, items={"VECTOR": (0.0, 0.0, 0.0)}).o.vector.filter(
              g.RandomValue.boolean(0.5)
          )
          >> filtered
      )
  
  '''
# ---
# name: test_snapshot_chain_simple
  '''
  from nodebpy import geometry as g, TreeBuilder
  
  with TreeBuilder("ChainSnap") as tree:
      geometry = tree.inputs.geometry("Geometry")
      geometry_1 = tree.outputs.geometry("Geometry")
  
      geometry >> g.SetPosition() >> g.TransformGeometry() >> geometry_1
  '''
# ---
# name: test_snapshot_chain_with_extra_kwargs
  '''
  from nodebpy import geometry as g, TreeBuilder
  
  with TreeBuilder("ChainKwargs") as tree:
      geometry = tree.inputs.geometry("Geometry")
      geometry_1 = tree.outputs.geometry("Geometry")
  
      (
          geometry
          >> g.SetPosition(offset=g.Position())
          >> g.TransformGeometry()
          >> geometry_1
      )
  '''
# ---
# name: test_snapshot_fanout
  '''
  from nodebpy import geometry as g, TreeBuilder
  
  with TreeBuilder("SnapshotFanOut") as tree:
      geometry = tree.inputs.geometry("Geometry")
      out1 = tree.outputs.geometry("Out1")
      out2 = tree.outputs.geometry("Out2")
  
      noise_texture = g.NoiseTexture()
      set_position = g.SetPosition(geometry=geometry, offset=noise_texture.o.color)
      set_position_1 = g.SetPosition(geometry=geometry, offset=noise_texture.o.color)
  
      set_position >> out1
      set_position_1 >> out2
  '''
# ---
# name: test_snapshot_keep_reroutes_block
  '''
  from nodebpy import geometry as g, TreeBuilder
  
  with TreeBuilder("KeepReroute", arrange=None) as tree:
      geometry = tree.inputs.geometry("Geometry")
      geometry_1 = tree.outputs.geometry("Geometry")
  
      (
          g.Reroute(input=g.SetPosition(geometry=geometry, offset=g.Position()).o.geometry)
          >> geometry_1
      )
  
  # Restore authored node names and positions (matched by tree
  # structure — see TreeBuilder.layout_snapshot).
  tree.layout_snapshot = {
      "Group Input": ("NodeGroupInput", (0.0, 0.0), None, ()),
      "Group Output": ("NodeGroupOutput", (90.0, 30.0), None, (("Geometry", "Reroute", "Output"), )),
      "Position": ("GeometryNodeInputPosition", (180.0, 60.0), None, ()),
      "Reroute": ("NodeReroute", (360.0, 120.0), None, (("Input", "Set Position", "Geometry"), )),
      "Set Position": ("GeometryNodeSetPosition", (270.0, 90.0), None, (("Geometry", "Group Input", "Geometry"), ("Offset", "Position", "Position"), )),
  }
  '''
# ---
